{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Manifest",
  "version": "0.1.0",
  "identifier": "com.griffincancode.manifest",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Manifest",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "dragDropEnabled": false,
        "shadow": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws://localhost:*; media-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "copyright": "Copyright © 2025 Griffin (griffincancode@gmail.com)",
    "shortDescription": "Manifest",
    "longDescription": "Manifest is a strategy game featuring civilizations, economies, and strategic warfare.",
    "targets": ["deb", "dmg", "msi", "app", "appimage"],
    "resources": ["assets/*", "lua-scripts/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null,
      "exceptionDomain": "localhost",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["webkit2gtk-4.0", "libgtk-3-0"],
        "section": "games",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "fs": {
      "scope": ["$APPDATA/*", "$APPDATA/saves/*"]
    },
    "dialog": {
      "open": true,
      "save": true
    },
    "window-state": {
      "filename": "window-state.json"
    },
    "updater": {
      "active": false
    }
  }
}
